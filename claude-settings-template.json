{
  "//": "just rename to settings.local.json and paste into .claude in a project",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run format:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run pre-push:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(require('os').homedir(), '.claude-scripts', 'play-sound.js'))\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(require('os').homedir(), '.claude-scripts', 'play-sound.js'))\""
          }
        ]
      },
      {
        "matcher": "PermissionRequest",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(require('os').homedir(), '.claude-scripts', 'play-sound.js'))\""
          }
        ]
      }
    ]
  }
}
